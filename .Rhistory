# Si pas déjà installé
# install.packages("randomForest")
# Importation des paquetages
require(randomForest)
require(rpart)
require(rpart.plot)
require(caret)
require(pROC)
dat.compl <- read.csv("heart_dataset.csv", stringsAsFactors = TRUE)
str(dat.compl)
RNGkind(sample.kind = "Rejection") #Pour corriger la différence entre la fonction sample de R 3.6.0(nouvellement modifiée) et celle de rmarkdown
set.seed(2153)
ind.entr <- sample(1:nrow(dat.compl), 0.8*nrow(dat.compl), FALSE)
dat <- dat.compl[ind.entr,]
dat.test <- dat.compl[-ind.entr,]
#Remplacez AAA et BBB pour construire l'arbre non-élagué.
set.seed(56660)
## a)
arbre <- rpart(target~.,
method = "class",
data = dat,
control = rpart.control(cp = 0,
minbucket = 2,
xval = 5))
rpart.plot(arbre)
## b)
arbre$cptable
plotcp(arbre, upper = "splits")
cp_opti = arbre$cptable[which.min(arbre$cptable[, 4]), 1]
## c)
pruned_tree = prune(arbre, cp = cp_opti)
## d)
rpart.plot(pruned_tree, type = 5, fallen.leaves = FALSE,
tweak = 1.2)
arbre.res <- pROC::roc(dat.test$target, predict(pruned_tree, newdata = dat.test, type = "prob")[, 2], auc = TRUE,
plot = TRUE)
arbre.res # not bad
# Corrigez la fonction suivante pour répondre à la question 3.
set.seed(12323)
bag <- randomForest(target~.,
data = dat,
mtry = 13, # on prend toutes les colonnes (variables explicatives) à chaque noeud
sampsize = nrow(dat), # on prend un échantillon de taille n pour bâtir chaque arbre
importance = TRUE,
ntree = 100,
nodesize = 2)
bag$oob.times[1]
bag$oob.times[2]
plot(1:dim(bag$err.rate)[1],bag$err.rate[,1], type="l", xlab="B", ylab="Taux d'erreur OOB", main="Bagging")
getTree(bag, 1, labelVar=TRUE)
getTree(bag, 2, labelVar=TRUE)
