dev.pois <- function(preds, clnb){
dev_one <- function(pred, cl)
{
ifelse(cl == 0, 2 * sum(- cl + pred),
2*sum(cl * log(cl / pred) - (cl - pred)))
}
mean(sapply(1:length(preds), function(i) dev_one(preds[i], clnb[i])))
}
